
#include <Servo.h>

// Pin connections
const int servoPin = 9;
const int buttonPin = 2;

// Servo positions 
const int lockedPosition = 0;
const int unlockedPosition = 90;

Servo doorServo;

bool isLocked = true;
int lastButtonState = HIGH;

void setup() {
  doorServo.attach(servoPin);

  pinMode(buttonPin, INPUT_PULLUP);

  // Start with the door locked
  doorServo.write(lockedPosition);

  Serial.begin(9600);
  Serial.println("Arduino Servo Door Lock Ready");
  Serial.println("Press the button to toggle the lock.");
}

void loop() {
  int buttonState = digitalRead(buttonPin);

  // Detect a new button press
  if (lastButtonState == HIGH && buttonState == LOW) {
    isLocked = !isLocked;

    if (isLocked) {
      doorServo.write(lockedPosition);
      Serial.println("Door locked");
    } else {
      doorServo.write(unlockedPosition);
      Serial.println("Door unlocked");
    }

    delay(250); // Basic button debounce
  }

  lastButtonState = buttonState;
}
